# KAFRIADA NET web tier. Copy to web/.env.local for local overrides (never committed).
# The web tier holds no secrets: it talks only to the API, server-side.

# The API's address. Locally the default is http://127.0.0.1:8010.
# On Render: the API's internal address (Private Service), e.g. http://kafriada-api:8010,
# or its public URL (Web Service), e.g. https://kafriada-api.onrender.com.
KAFRIADA_API_URL=http://127.0.0.1:8010

# Development only: serves /styleguide. Leave unset in any deployment.
# STYLEGUIDE=1
