# =============================================================================
# KAFRIADA CORE — example environment
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate every secret below with a fresh random value:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The application refuses to start if a secret is shorter than 32 characters or
# matches a known placeholder, so copying this file unchanged will fail loudly
# rather than run insecurely. That is deliberate.
# =============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO

# Interactive docs at /docs. Never true in staging or production — the API
# contract is published deliberately through the versioned OpenAPI document.
ENABLE_DOCS=true

# -----------------------------------------------------------------------------
# Database — four roles, four privilege levels.
#
# Passwords here must match those given to infra/bootstrap-roles.sql.
# database_url_app and database_url_money MUST use different roles: sharing one
# connection destroys the ledger privilege boundary and the app refuses to start
# in production if they match.
# -----------------------------------------------------------------------------
DATABASE_URL_APP=postgresql+psycopg://kaf_app:CHANGE_ME@localhost:5432/kafriada
DATABASE_URL_MONEY=postgresql+psycopg://kaf_money:CHANGE_ME@localhost:5432/kafriada
DATABASE_URL_READER=postgresql+psycopg://kaf_reader:CHANGE_ME@localhost:5432/kafriada
DATABASE_URL_MIGRATE=postgresql+psycopg://kaf_migrate:CHANGE_ME@localhost:5432/kafriada

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# -----------------------------------------------------------------------------
# Signing keys. Both are required. Generate each one separately — never reuse
# the same value for two purposes.
# -----------------------------------------------------------------------------
SECRET_KEY=
# Signs public QR profile links. Rotating this invalidates printed cards unless
# the version is incremented and the retired key is kept in build_qr_signer().
QR_SECRET=
QR_KEY_VERSION=1

# -----------------------------------------------------------------------------
# Sessions. Staff share phones in the field, so their sessions expire far sooner.
# -----------------------------------------------------------------------------
SESSION_IDLE_MINUTES_STAFF=30
SESSION_ABSOLUTE_DAYS_STAFF=7
SESSION_IDLE_DAYS_ATHLETE=30
SESSION_ABSOLUTE_DAYS_ATHLETE=90

# -----------------------------------------------------------------------------
# Password hashing. OWASP minimum for Argon2id is 19456 KiB, t=2, p=1.
# Do not lower these without measuring on the production instance and recording
# the reason. Raising memory is the strongest lever.
# -----------------------------------------------------------------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_HASH_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Money. Kobo, always. 250000 kobo = 2,500 naira.
#
# OPEN QUESTION A1: is 2,500 the price or the take-home? Paystack deducts roughly
# 1.5% + 100 naira, so 250000 kobo charged settles at about 236200. If the
# revenue model assumes 2,500 net, this becomes 264000.
# -----------------------------------------------------------------------------
PRICE_ATHLETE_VERIFICATION_KOBO=250000
PRICE_CLUB_VERIFICATION_KOBO=1500000

# -----------------------------------------------------------------------------
# Paystack. Use sk_test_ keys everywhere except production; the app refuses to
# start in production with a test key.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Who starts a checkout: none (payments say "not available yet"), fake (local only:
# sends the customer straight back, takes no money) or paystack (needs the key above).
# The webhook is verified with PAYSTACK_SECRET_KEY whichever is chosen.
PAYMENT_PROVIDER=none

# Photographs and identity documents. none (uploads say "not available yet"), local
# (a folder on this machine: development only) or r2 (a PRIVATE Cloudflare R2 bucket:
# never make it public, that would bypass the paywall and expose ID documents).
MEDIA_STORE=none
MEDIA_LOCAL_DIR=.media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# -----------------------------------------------------------------------------
# SMS. 'none' keeps messages queued in ops.outbox — registration still works and
# the codes go out when a provider is configured. 'console' prints them instead
# of sending and is refused outside local development. 'twilio' sends.
#
# A Messaging Service is preferred over a bare number: it is what holds the
# sender id registration a Nigerian route needs.
# -----------------------------------------------------------------------------
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SMS_TIMEOUT_SECONDS=10

# One-time codes. Six digits is only safe because of these three limits
# together; see api/src/kafriada/contexts/access/otp.py.
OTP_MINUTES_VALID=10
OTP_RESEND_SECONDS=60
OTP_SENDS_PER_DAY=5

# Termii was the original choice and may return as a second adapter.
TERMII_API_KEY=
TERMII_SENDER_ID=KAFRIADA

# -----------------------------------------------------------------------------
# Redis — rate limiting and the idempotency cache only. Never a job broker:
# durable work goes through the transactional outbox in PostgreSQL.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Observability. Sentry is inert without a DSN. Every event is scrubbed of phone
# numbers, bearer tokens and database URLs before it leaves the process, and
# request bodies are never captured — see src/kafriada/observability.py.
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Errors are always reported; traces are sampled. 0.1 = one request in ten.
SENTRY_TRACES_SAMPLE_RATE=0.1
# The deployed commit, set by the release step. Makes an issue point at a
# revision instead of at "staging".
RELEASE=

# -----------------------------------------------------------------------------
# HTTP. CORS stays empty: the browser talks only to the Next.js origin, which
# calls this service server-side. A non-empty list in production means the
# domain tier has been exposed directly to browsers.
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=[]
TRUSTED_HOSTS=["*"]
